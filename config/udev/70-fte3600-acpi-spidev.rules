# Experimental ACPI glue and stock spidev. No physical gpiochip permissions.
# Event-local guard: the Meson rule and standalone setup rule may coexist.
ENV{.FTE3600_RULES_DONE}=="1", GOTO="fte3600_pair_end"
ENV{.FTE3600_RULES_DONE}="1"
ACTION=="add|change", SUBSYSTEM=="spi", DRIVER=="", ENV{MODALIAS}=="acpi:FTE3600:*", RUN{builtin}+="kmod load spi:spidev", RUN+="/bin/sh -c 'echo spidev > %S%p/driver_override && echo %k > %S%p/subsystem/drivers/spidev/bind'"
ACTION=="add|change|bind", SUBSYSTEM=="spi", DRIVER=="spidev", ENV{MODALIAS}=="acpi:FTE3600:*", RUN{builtin}+="kmod load fte3600"
ACTION=="add|change|bind", SUBSYSTEM=="spi", DRIVER=="spidev", ENV{MODALIAS}=="acpi:FTE3600:*", RUN+="/usr/libexec/fte3600-pair --refresh-spi %p"
ACTION=="add|change", SUBSYSTEM=="spidev", KERNEL=="spidev*", ENV{FTE3600_PAIR_ROLE}="", ENV{FTE3600_PAIR_ID}=""
ACTION=="add|change", SUBSYSTEM=="spidev", KERNEL=="spidev*", IMPORT{program}="/usr/libexec/fte3600-pair --udev %p"
ACTION=="add|change", SUBSYSTEM=="gpio", KERNEL=="gpiochip*", ENV{FTE3600_PAIR_ROLE}="", ENV{FTE3600_PAIR_ID}=""
ACTION=="add|change", SUBSYSTEM=="gpio", KERNEL=="gpiochip*", IMPORT{program}="/usr/libexec/fte3600-pair --udev %p"
ACTION=="add|change", SUBSYSTEM=="uio", KERNEL=="uio*", ENV{FTE3600_PAIR_ROLE}="", ENV{FTE3600_PAIR_ID}=""
ACTION=="add|change", SUBSYSTEM=="uio", KERNEL=="uio*", IMPORT{program}="/usr/libexec/fte3600-pair --udev %p"
ENV{FTE3600_PAIR_ROLE}=="spi", OWNER="root", GROUP="root", MODE="0600", SYMLINK+="fte3600-spi-$env{FTE3600_PAIR_ID}", TAG+="systemd"
ENV{FTE3600_PAIR_ROLE}=="gpio", OWNER="root", GROUP="root", MODE="0600", SYMLINK+="fte3600-gpio-$env{FTE3600_PAIR_ID}", TAG+="systemd"
ENV{FTE3600_PAIR_ROLE}=="irq", OWNER="root", GROUP="root", MODE="0600", SYMLINK+="fte3600-irq-$env{FTE3600_PAIR_ID}", TAG+="systemd"
LABEL="fte3600_pair_end"
