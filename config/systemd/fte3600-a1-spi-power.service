[Unit]
Description=One-Netbook A1 FTE3600 SPI power workaround
Documentation=https://github.com/SamSeven777/libfprint-fte3600
ConditionFirmware=smbios-field(sys_vendor = "ONE-NETBOOK TECHNOLOGY CO., LTD.")
ConditionFirmware=smbios-field(product_name = A1)
Before=fprintd.service

[Service]
Type=oneshot
RemainAfterExit=yes
RuntimeDirectory=libfprint-fte3600
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
UMask=0077
ExecStart=/usr/lib/libfprint/fte3600-a1-spi-power start
# ExecStopPost also runs after a failed or timed-out start, so saved policies
# are restored and an interrupted platform rebind gets a recovery attempt.
ExecStopPost=/usr/lib/libfprint/fte3600-a1-spi-power stop
TimeoutStartSec=30s
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
