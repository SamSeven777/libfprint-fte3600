#!/bin/sh
# SPDX-FileCopyrightText: 2026 FTE3600 Linux contributors
# SPDX-License-Identifier: LGPL-2.1-or-later

set -u
umask 077

program=${0##*/}
platform_name=pxa2xx-spi.4
pci_name=0000:00:1e.3
transaction_active=false
controller_unbound=false

log()
{
  printf '%s: %s\n' "$program" "$*" >&2
}

fail()
{
  log "error: $*"
  exit 1
}

skip()
{
  log "not applicable: $*"
  exit 0
}

read_value()
{
  [ -r "$1" ] || return 1
  cat "$1"
}

write_value()
{
  value=$1
  path=$2

  printf '%s\n' "$value" > "$path" || return 1

  # A regular-file fixture cannot reproduce sysfs driver-core side effects,
  # so test mode mirrors only this exact bind/unbind lifecycle.
  if [ "${testing:-false}" = true ]; then
    if [ "$path" = "$platform_driver/unbind" ]; then
      rm -f "$platform_device/driver"
    elif [ "$path" = "$platform_driver/bind" ] &&
         [ ! -L "$platform_device/driver" ]; then
      ln -s "$platform_driver" "$platform_device/driver"
    fi
  fi
}

test_root=${FTE3600_TEST_ROOT:-}
if [ -n "$test_root" ]; then
  case "$test_root" in
    /*) ;;
    *) fail 'FTE3600_TEST_ROOT must be an absolute path' ;;
  esac
  [ "$test_root" != / ] || fail 'refusing to use / as FTE3600_TEST_ROOT'
  [ -f "$test_root/.fte3600-test-root" ] ||
    fail 'FTE3600_TEST_ROOT is missing its safety marker'
  test_root=$(readlink -f "$test_root") || fail 'cannot resolve test root'
  sysfs_root=$test_root/sys
  state_dir=$test_root/run/libfprint-fte3600
  testing=true
else
  [ "$(id -u)" -eq 0 ] || fail 'must run as root'
  sysfs_root=/sys
  state_dir=/run/libfprint-fte3600
  testing=false
fi

dmi_root=$sysfs_root/class/dmi/id
acpi_device=$sysfs_root/bus/acpi/devices/FTE3600:00
pci_device=$sysfs_root/bus/pci/devices/$pci_name
platform_link=$sysfs_root/bus/platform/devices/$platform_name
platform_driver=$sysfs_root/bus/platform/drivers/pxa2xx-spi
parent_control=$pci_device/power/control

is_one_netbook_a1()
{
  [ "$(read_value "$dmi_root/sys_vendor" 2>/dev/null || :)" = \
    'ONE-NETBOOK TECHNOLOGY CO., LTD.' ] &&
    [ "$(read_value "$dmi_root/product_name" 2>/dev/null || :)" = A1 ]
}

validate_platform()
{
  is_one_netbook_a1 || skip 'DMI is not the verified One-Netbook A1 profile'
  [ -d "$acpi_device" ] || fail 'ACPI FTE3600:00 device is absent'
  [ "$(read_value "$acpi_device/hid" 2>/dev/null || :)" = FTE3600 ] ||
    fail 'ACPI HID is not FTE3600'
  [ "$(read_value "$acpi_device/status" 2>/dev/null || :)" = 15 ] ||
    fail 'ACPI FTE3600 device is not fully enabled'
  [ "$(read_value "$acpi_device/modalias" 2>/dev/null || :)" = \
    'acpi:FTE3600:' ] || fail 'ACPI modalias is not FTE3600'
  [ "$(read_value "$acpi_device/path" 2>/dev/null || :)" = \
    '\_SB_.PCI0.SPI1.FPRT' ] || fail 'ACPI path is not the verified A1 path'

  [ -d "$pci_device" ] || fail "PCI controller $pci_name is absent"
  [ "$(read_value "$pci_device/vendor" 2>/dev/null || :)" = 0x8086 ] ||
    fail 'SPI parent is not an Intel PCI device'
  [ "$(read_value "$pci_device/device" 2>/dev/null || :)" = 0x9d2a ] ||
    fail 'SPI parent is not the verified Intel LPSS controller'
  [ "$(read_value "$pci_device/class" 2>/dev/null || :)" = 0x118000 ] ||
    fail 'SPI parent has an unexpected PCI class'
  [ "$(basename "$(readlink -f "$pci_device/driver" 2>/dev/null || :)")" = \
    intel-lpss ] || fail 'SPI parent is not bound to intel-lpss'

  pci_real=$(readlink -f "$pci_device") || fail 'cannot resolve PCI controller'
  platform_device=$(readlink -f "$platform_link") ||
    fail "platform controller $platform_name is absent"
  [ "$platform_device" = "$pci_real/$platform_name" ] ||
    fail 'pxa2xx SPI controller is not below the verified PCI parent'
  [ "$(basename "$(readlink -f "$platform_device/subsystem" 2>/dev/null || :)")" = \
    platform ] || fail 'pxa2xx controller has an unexpected subsystem'
  [ "$(readlink -f "$platform_device/driver" 2>/dev/null || :)" = \
    "$(readlink -f "$platform_driver" 2>/dev/null || :)" ] ||
    fail 'platform controller is not bound to pxa2xx-spi'

  child_control=$platform_device/power/control
  [ -w "$parent_control" ] || fail "cannot write $parent_control"
  [ -w "$child_control" ] || fail "cannot write $child_control"
  [ -w "$platform_driver/unbind" ] || fail 'pxa2xx-spi unbind is unavailable'
  [ -w "$platform_driver/bind" ] || fail 'pxa2xx-spi bind is unavailable'
}

find_only_spi_device()
{
  spi_count=0
  spi_device=

  for spi_master in "$platform_device"/spi_master/spi[0-9]*; do
    [ -d "$spi_master" ] || continue
    for candidate in "$spi_master"/*; do
      [ -e "$candidate" ] || continue
      [ "$(basename "$(readlink -f "$candidate/subsystem" 2>/dev/null || :)")" = \
        spi ] || continue
      spi_count=$((spi_count + 1))
      spi_device=$(readlink -f "$candidate") || return 1
    done
  done

  [ "$spi_count" -eq 1 ] || return 1
  [ "${spi_device##*/}" = spi-FTE3600:00 ] || return 1
  return 0
}

validate_spi_device()
{
  find_only_spi_device ||
    fail 'the controller does not contain exactly one FTE3600 SPI device'

  acpi_physical=$(readlink -f "$acpi_device/physical_node" 2>/dev/null || :)
  [ "$acpi_physical" = "$spi_device" ] ||
    fail 'ACPI FTE3600 physical node does not match the SPI device'
  [ "$(basename "$(readlink -f "$spi_device/subsystem" 2>/dev/null || :)")" = \
    spi ] || fail 'FTE3600 has an unexpected subsystem'
  [ "$(read_value "$spi_device/modalias" 2>/dev/null || :)" = \
    'acpi:FTE3600:' ] || fail 'SPI modalias is not FTE3600'

  spi_driver=
  if [ -L "$spi_device/driver" ]; then
    spi_driver=$(basename "$(readlink -f "$spi_device/driver")")
    [ "$spi_driver" = spidev ] ||
      skip "FTE3600 is owned by native driver $spi_driver"
  fi
}

save_controls()
{
  parent_current=$(read_value "$parent_control") ||
    fail 'cannot read PCI parent power policy'
  child_current=$(read_value "$child_control") ||
    fail 'cannot read pxa2xx power policy'
  case "$parent_current:$child_current" in
    auto:auto|auto:on|on:auto|on:on) ;;
    *) fail 'unexpected runtime power policy value' ;;
  esac

  if [ -L "$state_dir" ]; then
    fail "$state_dir must not be a symbolic link"
  fi
  mkdir -p "$state_dir" || fail "cannot create $state_dir"
  chmod 0700 "$state_dir" || fail "cannot protect $state_dir"
  if [ -e "$state_dir/parent-control" ] || [ -L "$state_dir/parent-control" ]; then
    [ -f "$state_dir/parent-control" ] && [ ! -L "$state_dir/parent-control" ] ||
      fail 'saved PCI parent policy is not a regular file'
    case "$(read_value "$state_dir/parent-control" 2>/dev/null || :)" in
      auto|on) ;;
      *) fail 'saved PCI parent power policy is invalid' ;;
    esac
  else
    write_value "$parent_current" "$state_dir/parent-control" ||
      fail 'cannot save PCI parent power policy'
    chmod 0600 "$state_dir/parent-control" || fail 'cannot protect saved PCI policy'
  fi
  if [ -e "$state_dir/child-control" ] || [ -L "$state_dir/child-control" ]; then
    [ -f "$state_dir/child-control" ] && [ ! -L "$state_dir/child-control" ] ||
      fail 'saved pxa2xx policy is not a regular file'
    case "$(read_value "$state_dir/child-control" 2>/dev/null || :)" in
      auto|on) ;;
      *) fail 'saved pxa2xx power policy is invalid' ;;
    esac
  else
    write_value "$child_current" "$state_dir/child-control" ||
      fail 'cannot save pxa2xx power policy'
    chmod 0600 "$state_dir/child-control" || fail 'cannot protect saved pxa2xx policy'
  fi
}

restore_one_control()
{
  state_file=$1
  control_file=$2
  label=$3

  if [ ! -e "$state_file" ] && [ ! -L "$state_file" ]; then
    return 0
  fi
  [ -f "$state_file" ] && [ ! -L "$state_file" ] && [ -r "$state_file" ] || {
    log "saved $label power policy is not a readable regular file"
    return 1
  }
  [ -e "$control_file" ] || {
    log "$label disappeared before its power policy could be restored"
    return 0
  }
  [ -w "$control_file" ] || {
    log "$label power policy is no longer writable"
    return 1
  }

  original=$(read_value "$state_file") || {
    log "could not read saved $label power policy"
    return 1
  }
  case "$original" in
    auto|on) ;;
    *) log "invalid saved $label power policy"; return 1 ;;
  esac

  current=$(read_value "$control_file" 2>/dev/null) || {
    log "could not read current $label power policy"
    return 1
  }
  if [ "$current" != on ]; then
    log "$label power policy changed externally; leaving it at $current"
    return 0
  fi

  if ! write_value "$original" "$control_file"; then
    log "could not restore $label power policy"
    return 1
  fi
}

restore_controls()
{
  restore_result=0
  restore_one_control "$state_dir/child-control" "$child_control" \
    'pxa2xx child' || restore_result=1
  restore_one_control "$state_dir/parent-control" "$parent_control" \
    'Intel LPSS parent' || restore_result=1
  return "$restore_result"
}

clear_saved_controls()
{
  clear_result=0
  for state_file in \
    "$state_dir/parent-control" \
    "$state_dir/child-control"; do
    if [ -e "$state_file" ] || [ -L "$state_file" ]; then
      [ -f "$state_file" ] && [ ! -L "$state_file" ] || {
        log "refusing to remove unexpected state entry $state_file"
        clear_result=1
        continue
      }
      rm -f "$state_file" || clear_result=1
    fi
  done
  return "$clear_result"
}

controller_driver_path()
{
  [ -L "$platform_device/driver" ] && [ -e "$platform_device/driver" ] ||
    return 0
  readlink -f "$platform_device/driver" 2>/dev/null || :
}

bind_controller()
{
  expected_driver=$(readlink -f "$platform_driver" 2>/dev/null || :)
  [ -n "$expected_driver" ] || return 1
  [ "$controller_unbound" = false ] &&
    [ "$(controller_driver_path)" = "$expected_driver" ] &&
    return 0

  if write_value "$platform_name" "$platform_driver/bind" 2>/dev/null; then
    [ "$(controller_driver_path)" = "$expected_driver" ] &&
      return 0
  fi

  # Retry once, but accept an EBUSY race only when the expected driver won it.
  if write_value "$platform_name" "$platform_driver/bind" 2>/dev/null; then
    [ "$(controller_driver_path)" = "$expected_driver" ] &&
      return 0
  fi
  [ "$(controller_driver_path)" = "$expected_driver" ]
}

rollback_transaction()
{
  transaction_active=false
  if [ "$controller_unbound" = true ] || [ -z "$(controller_driver_path)" ]; then
    if bind_controller; then
      controller_unbound=false
    else
      log 'could not rebind pxa2xx-spi during rollback; reboot is required'
    fi
  fi
  restore_controls || log 'could not fully restore runtime PM during rollback'
}

cleanup_on_exit()
{
  result=$?
  trap - 0 HUP INT TERM
  if [ "$transaction_active" = true ]; then
    rollback_transaction
  fi
  exit "$result"
}

interrupted()
{
  fail 'interrupted while changing the SPI controller state'
}

start_workaround()
{
  validate_platform
  validate_spi_device
  save_controls
  transaction_active=true

  if ! write_value on "$parent_control"; then
    fail 'cannot disable runtime PM for the Intel LPSS parent'
  fi
  if ! write_value on "$child_control"; then
    fail 'cannot disable runtime PM for the pxa2xx child'
  fi

  # Current power-policy values cannot prove that the sensor/controller is
  # healthy: they may have been changed only after runtime suspend broke it.
  # Rebind once per service activation, after proving this controller contains
  # only the exact A1 FTE3600 device.
  if ! write_value "$platform_name" "$platform_driver/unbind"; then
    fail 'cannot unbind the pxa2xx SPI controller'
  fi
  controller_unbound=true
  if ! bind_controller; then
    fail 'cannot rebind the pxa2xx SPI controller'
  fi
  controller_unbound=false

  # Reassert both policies after driver probe before allowing fprintd to run.
  write_value on "$parent_control" || {
    fail 'PCI parent power policy changed during rebind'
  }
  write_value on "$child_control" || {
    fail 'pxa2xx power policy changed during rebind'
  }

  if [ "$testing" = false ] && command -v udevadm >/dev/null 2>&1; then
    udevadm settle --timeout=10 || log 'udev settle timed out; checking anyway'
  fi

  [ "$(read_value "$parent_control" 2>/dev/null || :)" = on ] ||
    fail 'Intel LPSS parent runtime PM was re-enabled during startup'
  [ "$(read_value "$child_control" 2>/dev/null || :)" = on ] ||
    fail 'pxa2xx child runtime PM was re-enabled during startup'

  find_only_spi_device || {
    fail 'FTE3600 did not return after pxa2xx rebind'
  }

  if [ ! -L "$spi_device/driver" ] ||
     [ "$(basename "$(readlink -f "$spi_device/driver")")" != spidev ]; then
    fail 'FTE3600 did not bind to spidev after pxa2xx rebind'
  fi

  transaction_active=false
  log 'runtime PM disabled for the verified A1 FTE3600 SPI controller'
}

stop_workaround()
{
  is_one_netbook_a1 || exit 0
  [ -d "$pci_device" ] || exit 0
  pci_real=$(readlink -f "$pci_device") || exit 0
  platform_device=$(readlink -f "$platform_link") || exit 0
  [ "$platform_device" = "$pci_real/$platform_name" ] || exit 0
  child_control=$platform_device/power/control

  [ -r "$state_dir/parent-control" ] ||
    [ -r "$state_dir/child-control" ] || exit 0
  stop_result=0
  current_driver=$(controller_driver_path)
  if [ -z "$current_driver" ]; then
    bind_controller || {
      log 'could not rebind pxa2xx-spi while stopping; reboot is required'
      stop_result=1
    }
  elif [ "$current_driver" != "$(readlink -f "$platform_driver")" ]; then
    log 'platform controller is now owned by another driver; not rebinding it'
  fi
  restore_controls || stop_result=1
  if [ "$stop_result" -eq 0 ]; then
    clear_saved_controls || stop_result=1
  fi
  if [ "$stop_result" -eq 0 ]; then
    log 'restored the previous SPI runtime PM policies'
  fi
  return "$stop_result"
}

trap cleanup_on_exit 0
trap interrupted HUP INT TERM

case ${1:-} in
  start) start_workaround ;;
  stop) stop_workaround ;;
  *) fail 'usage: fte3600-a1-spi-power {start|stop}' ;;
esac
