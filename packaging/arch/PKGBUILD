# Maintainer: FTE3600 Linux contributors

pkgname=libfprint-fte3600-personal-git
# makepkg replaces this bootstrap value with pkgver() from the committed HEAD.
pkgver=1.94.100.r4
pkgrel=1
pkgdesc='libfprint with experimental FTE3600/FT9361 SPI support'
arch=(x86_64)
url='https://fprint.freedesktop.org/'
license=(LGPL-2.1-or-later)
groups=(fprint)
depends=(libgcc glib2 glibc libgudev libgusb openssl pixman libgpiod)
makedepends=(cairo git glib2-devel gobject-introspection meson ninja python)
provides=("libfprint=$pkgver" 'libfprint-2.so=2-64')
conflicts=(libfprint)
install=fte3600.install

# This developer PKGBUILD packages the committed checkout containing it. A
# release tag can replace this local VCS source with a fixed GitHub archive.
source=(
  "libfprint::git+file://${startdir}/../.."
  fte3600-gpio.conf
  fte3600-spidev.conf
)
sha256sums=(
  SKIP
  'f0fce5dd6685227aa22c54e045fd5ba518631a9afc2c2467fbbbae765f43df26'
  '71445336251cd3d18566ff2c86871c5ce229e3307eb47c05a1b5fd4df87d239b'
)

pkgver() {
  cd libfprint
  git describe --long --tags --match 'v[0-9]*' | \
    sed -E 's/^v//; s/-([0-9]+)-g/.r\1.g/'
}

build() {
  local meson_args=(
    --prefix=/usr
    --libdir=lib
    --buildtype=release
    -Db_lto=true
    -Dwerror=true
    -Ddrivers=all
    -Dfte3600_personal_auth=true
    -Dgtk-examples=false
    -Ddoc=false
    -Dinstalled-tests=false
  )

  meson setup "$srcdir/build" "$srcdir/libfprint" "${meson_args[@]}"
  meson compile -C "$srcdir/build"
}

check() {
  meson test -C "$srcdir/build" --print-errorlogs --no-rebuild \
    fpi-spi-transfer fte3600-driver fte3600-brisk fte3600-template
}

package() {
  DESTDIR="$pkgdir" meson install -C "$srcdir/build"

  install -Dm644 "$srcdir/fte3600-gpio.conf" \
    "$pkgdir/usr/lib/systemd/system/fprintd.service.d/10-fte3600-gpio.conf"
  install -Dm644 "$srcdir/fte3600-spidev.conf" \
    "$pkgdir/usr/lib/modprobe.d/fte3600-spidev.conf"
}
