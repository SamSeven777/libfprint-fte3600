# Maintainer: FTE3600 Linux contributors

pkgname=libfprint-fte3600-personal-git
# makepkg replaces this bootstrap value with pkgver() from the committed HEAD.
pkgver=1.94.100.r9
pkgrel=1
pkgdesc='libfprint with experimental FTE3600 sensor-family SPI support'
arch=(x86_64)
url='https://github.com/SamSeven777/libfprint-fte3600'
license=(LGPL-2.1-or-later GPL-2.0-only MIT)
groups=(fprint)
depends=(libgcc glib2 glibc libgudev libgusb openssl pixman dkms)
makedepends=(cairo git glib2-devel gobject-introspection meson ninja python)
provides=("libfprint=$pkgver" 'libfprint-2.so=2-64')
conflicts=(libfprint)
install=fte3600.install

# This developer PKGBUILD packages the committed checkout containing it. A
# release tag can replace this local VCS source with a fixed GitHub archive.
source=(
  "libfprint::git+file://${startdir}/../.."
)
sha256sums=(
  SKIP
)

# Upstream libfprint development snapshot from which the FTE3600 work starts.
_fte_upstream_base=c4654fdc85c25afdd9115bec2f95a44145ae3b94

pkgver() {
  cd libfprint

  local upstream_version revision short_commit
  upstream_version=$(awk -F"'" \
    '/^[[:space:]]*version:/ { print $2; exit }' meson.build)
  revision=$(git rev-list --count "${_fte_upstream_base}..HEAD")
  short_commit=$(git rev-parse --short=7 HEAD)

  printf '%s.r%s.g%s' "$upstream_version" "$revision" "$short_commit"
}

build() {
  local meson_args=(
    --prefix=/usr
    --libdir=lib
    --buildtype=release
    -Db_lto=true
    -Dwerror=true
    -Ddrivers=all,fte3600
    -Dfte3600_personal_auth=true
    -Dgtk-examples=false
    -Ddoc=false
    -Dinstalled-tests=false
  )

  meson setup "$srcdir/build" "$srcdir/libfprint" "${meson_args[@]}"
  meson compile -C "$srcdir/build"
}

check() {
  meson test -C "$srcdir/build" --print-errorlogs --no-rebuild \
    fpi-device-cancel fpi-spi-transfer fte3600-context fte3600-driver \
    fte3600-sensor fte3600-firmware fte3600-protocol fte3600-lifecycle \
    brisk-core fte3600-brisk fte3600-template \
    fw9369-protocol ft93xx-protocol ft9368-protocol \
    ft9368-backend fw9369-backend ft93xx-backend legacy38-recovery \
    fte3600-special-probe fte3600-family-template fte3600-auth-lifecycle \
    fte3600-install-firmware
}

package() {
  DESTDIR="$pkgdir" meson install -C "$srcdir/build"

  install -Dm644 "$srcdir/libfprint/kernel/fte3600/dkms.conf" "$pkgdir/usr/src/fte3600-0.1/dkms.conf"
  for file in fte3600.c fte3600-policy.h fte3600-bridge.h Makefile; do
    install -Dm644 "$srcdir/libfprint/kernel/fte3600/$file" "$pkgdir/usr/src/fte3600-0.1/$file"
  done
  install -Dm755 "$srcdir/libfprint/scripts/fte3600-device-allow.sh" "$pkgdir/usr/bin/fte3600-device-allow"

  # Firmware is supplied separately by the device owner. Never silently
  # bundle an ignored local blob into an otherwise reproducible package.
}
