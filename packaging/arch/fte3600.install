post_install() {
  systemctl daemon-reload
  udevadm control --reload
  printf '%s\n' \
    'FTE3600: reboot before enrollment so spidev.bufsiz and enumeration are refreshed.'
}

post_upgrade() {
  post_install
}

pre_upgrade() {
  # One-time migration: restore saved policies before an old package's helper
  # is removed. New packages no longer ship or start this workaround.
  if [ -x /usr/lib/libfprint/fte3600-a1-spi-power ]; then
    systemctl stop fprintd.service 2>/dev/null || true
    systemctl stop fte3600-a1-spi-power.service 2>/dev/null || true
    /usr/lib/libfprint/fte3600-a1-spi-power stop 2>/dev/null || \
      printf '%s\n' 'FTE3600: legacy SPI power policy could not be restored; check power/control.' >&2
  fi
}

post_remove() {
  systemctl daemon-reload
  udevadm control --reload
}
