post_install() {
  systemctl daemon-reload
  udevadm control --reload
  printf '%s\n' \
    'FTE3600: install matching kernel headers for the DKMS GPIO glue.' \
    'See docs/fte3600/install.md for setup and removal instructions.' \
    'spidev needs bufsiz >= 65536; reboot after changing its loaded configuration.' \
    'Generate exact companion-node fprintd permissions only after all three nodes are present.'
}

post_upgrade() {
  post_install
}


post_remove() {
  systemctl daemon-reload
  udevadm control --reload
}
